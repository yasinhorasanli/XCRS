# VM-A configuration (deploy/vm-a/compose.yaml). Copy to .env; never commit .env.
XCRS_IMAGE_OWNER=yasinhorasanli
XCRS_IMAGE_TAG=modernization          # or an immutable commit SHA from GHCR
XCRS_DOMAIN=:80                       # HTTP inside; Tailscale Funnel adds HTTPS (ADR-0040)
XCRS_HTTP_PORT=8080                   # Caddy on 127.0.0.1:8080; `tailscale funnel --bg 8080`
POSTGRES_PASSWORD=change-me
XCRS_LLM_BASE_URL=http://192.168.99.171:11434/v1   # VM-B's private address (deploy/vm-b)
XCRS_LLM_MODEL=qwen3.5:4b
XCRS_YOUTUBE_API_KEY=
# Backups (deploy/systemd, ADR-0036): where scripts/db-offsite-copy.sh sends dumps
XCRS_BACKUP_REMOTE=backup@192.168.99.171:/srv/xcrs-backups
