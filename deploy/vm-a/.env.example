# VM-A configuration (deploy/vm-a/compose.yaml). Copy to .env; never commit .env.
# Comments go on their own lines: systemd's EnvironmentFile (backups) keeps text after a value.
XCRS_IMAGE_OWNER=yasinhorasanli
# or an immutable commit SHA from GHCR
XCRS_IMAGE_TAG=modernization
# HTTP inside; Tailscale Funnel adds HTTPS (ADR-0040)
XCRS_DOMAIN=:80
# Caddy on 127.0.0.1:8080; `tailscale funnel --bg 8080`
XCRS_HTTP_PORT=8080
POSTGRES_PASSWORD=change-me
# VM-B's private address (deploy/vm-b)
XCRS_LLM_BASE_URL=http://192.168.99.171:11434/v1
XCRS_LLM_MODEL=qwen3.5:4b
XCRS_YOUTUBE_API_KEY=
# Backups (deploy/systemd, ADR-0036): where scripts/db-offsite-copy.sh sends dumps
XCRS_BACKUP_REMOTE=backup@192.168.99.171:/srv/xcrs-backups
# Dev tools: the test-profiles page at /dev/profiles (tailnet only; Caddy answers 404 to public requests)
XCRS_DEV_TOOLS=false
