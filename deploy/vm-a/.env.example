# VM-A configuration (deploy/vm-a/compose.yaml). Copy to .env; never commit .env.
# Comments go on their own lines: systemd's EnvironmentFile (backups) keeps text after a value.
XCRS_IMAGE_OWNER=yasinhorasanli
# or an immutable commit SHA from GHCR
XCRS_IMAGE_TAG=main
# HTTP inside; Tailscale Funnel adds HTTPS (ADR-0040)
XCRS_DOMAIN=:80
# Caddy on 127.0.0.1:8080; `tailscale funnel --bg 8080`
XCRS_HTTP_PORT=8080
POSTGRES_PASSWORD=change-me
# VM-B's private address (deploy/vm-b)
XCRS_LLM_BASE_URL=http://192.168.99.171:11434/v1
XCRS_LLM_MODEL=qwen3.5:4b
XCRS_YOUTUBE_API_KEY=
# Backups (deploy/systemd, ADR-0036): where scripts/db-offsite-copy.sh sends dumps
XCRS_BACKUP_REMOTE=backup@192.168.99.171:/srv/xcrs-backups
# Dev tools: the test-profiles page at /dev/profiles (tailnet only; Caddy answers 404 to public requests)
XCRS_DEV_TOOLS=false
# Accounts (ADR-0043). Leave empty for an anonymous-only site. Secrets: `openssl rand -hex 32` each.
# The public address, for the providers' redirect URLs (<XCRS_PUBLIC_URL>/auth/github|google|linkedin)
XCRS_PUBLIC_URL=https://xcrs-a.tail3afc6e.ts.net
# Shared by web and api: the web server signs the signed-in user's id with it
XCRS_INTERNAL_SECRET=
# Seals the session cookie (at least 32 characters); changing it signs everyone out
NUXT_SESSION_PASSWORD=
# OAuth apps registered by the decider; a provider shows up once both of its values are set
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_LINKEDIN_CLIENT_ID=
NUXT_OAUTH_LINKEDIN_CLIENT_SECRET=
