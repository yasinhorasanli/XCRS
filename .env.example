# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=xcrs
POSTGRES_USER=xcrs
POSTGRES_PASSWORD=xcrs

# Backend
XCRS_DATABASE_URL=postgresql+psycopg://xcrs:xcrs@localhost:5432/xcrs

# Embedding endpoint: any OpenAI-compatible server (ADR-0006).
# Mac: native Ollama. From inside a container use http://host.docker.internal:11434/v1
XCRS_EMBEDDING_BASE_URL=http://localhost:11434/v1
XCRS_EMBEDDING_MODEL=qwen3-embedding:0.6b
