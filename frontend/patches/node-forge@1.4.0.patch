+          // XCRS patch (GHSA-86w9-cpqp-85rv): the validator ignores extra or
+          // unexpected elements inside DigestAlgorithm, so rebuild the only
+          // encodings RFC 8017 allows (NULL parameters, or none except for
+          // md2/md5) and require the decrypted bytes to equal one of them.
+          var C = asn1.Class.UNIVERSAL;
+          var canonical = function(withNull) {
+            var algorithm = [asn1.create(C, asn1.Type.OID, false,
+              asn1.oidToDer(oid).getBytes())];
+            if(withNull) {
+              algorithm.push(asn1.create(C, asn1.Type.NULL, false, ''));
+            }
+            return asn1.toDer(asn1.create(C, asn1.Type.SEQUENCE, true, [
+              asn1.create(C, asn1.Type.SEQUENCE, true, algorithm),
+              asn1.create(C, asn1.Type.OCTETSTRING, false, capture.digest)
+            ])).getBytes();
+          };
+          var nullRequired = oid === forge.oids.md2 || oid === forge.oids.md5;
+          if(d !== canonical(true) && (nullRequired || d !== canonical(false))) {
+            throw new Error(
+              'ASN.1 object does not contain a valid RSASSA-PKCS1-v1_5 ' +
+              'DigestInfo value. Non-canonical DigestInfo encoding.');
+          }
+
           // compare the given digest to the decrypted one
           return digest === capture.digest;
         }
