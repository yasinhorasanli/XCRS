+// XCRS patch (GHSA-vfj7-8cjw-p6xm): the AST walkers (compile, expand, stringify) recurse once per nesting
+// level, so deeply nested input exhausted the stack. Real patterns nest a few levels.
+const MAX_DEPTH = 100;
+const checkDepth = (stack) => {
+  if (stack.length > MAX_DEPTH) {
+    throw new SyntaxError(`Pattern nesting exceeds max depth (${MAX_DEPTH})`);
+  }
+};
